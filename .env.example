# ==========================================
# Server Configuration
# ==========================================
# The port number on which our Express server will run
PORT=5000

# ==========================================
# MongoDB Database Configuration
# ==========================================
# Connection string for our LOCAL MongoDB database
MONGO_URI=mongodb://localhost:27017/expensewise

# ==========================================
# JSON Web Token (JWT) Secret
# ==========================================
# Secret key used to sign and verify JWT authentication tokens
# You can change this to any random secure string
JWT_SECRET=mySuperSecretExpenseWiseKey_2026_jwt

# ==========================================
# Cloudinary Configuration (For Receipt Uploads)
# ==========================================
# Replace these placeholder values with your real credentials from your Cloudinary Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# ==========================================
# Email Notification Configuration (Nodemailer Gmail SMTP)
# ==========================================
# Use your Gmail address and a 16-character Gmail App Password (from Google Account Security)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ==========================================
# Frontend Client URL (For Password Reset Links)
# ==========================================
# Local development: http://localhost:5173
# Production URL: https://expense-wise-frontend-three.vercel.app
CLIENT_URL=https://expense-wise-frontend-three.vercel.app
